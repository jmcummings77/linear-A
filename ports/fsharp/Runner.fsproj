<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <NuGetLockFilePath>runner.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup><Compile Include="SparseRunner.fs" /><Compile Include="Runner.fs" /></ItemGroup>
  <ItemGroup><ProjectReference Include="LinearA.FSharp.fsproj" /></ItemGroup>
</Project>
